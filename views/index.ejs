<%- include("hero", { blendTitle: true }) %>

<section class="filters" id="projects">
  <button class="chip is-active" data-filter="all">All Projects</button>
  <button class="chip" data-filter="Movie">Movie</button>
  <button class="chip" data-filter="Animation">Animation</button>
  <button class="chip" data-filter="Documentary">Documentary</button>
  <button class="chip" data-filter="EventManagement">Event management</button>
  <button class="chip" data-filter="Directing">Directing</button>
  <button class="chip" data-filter="ProjectionMapping">Projection mapping</button>
</section>

<section class="grid">
  <% (projects || []).forEach(p => { %>
    <article class="card" data-tags="<%= (p.tags || []).join(',') %>">
      <a class="card__link" href="/projects/<%= p.slug %>">
        <div class="card__thumb">
          <img
            class="thumb__img"
            src="<%= p.thumb %>"
            alt="<%= p.title %> thumbnail"
            loading="lazy"
          />
        </div>

        <div class="card__meta">
          <div class="card__title">
            <span><%= p.title %></span>
            <span class="card__year"><%= p.year %></span>
          </div>

          <div class="card__desc"><%= p.desc %></div>
          <div class="card__tags"><%= (p.tags || []).join(" ") %></div>
        </div>
      </a>
    </article>
  <% }) %>
</section>